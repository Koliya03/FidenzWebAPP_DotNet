@model FidenzApp.Application.DTO.CustomerDto
@using System.Linq

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="d-flex align-items-center">
                            <a href="javascript:history.back()"
                               class="bi bi-arrow-left-square-fill px-3"
                               style="font-size: 2rem;">
                            </a>
                           <div>
                                <h4 class="mb-1">@Model.name</h4>
                                <div class="text-muted">
                                    <i class="bi bi-building me-1"></i>@(Model.company ?? "—")
                                </div>
                           </div>
                            
                        </div>
                        <div>
                            <div class="d-block btn btn-primary btn-sm">
                                <i class="bi bi-pencil-square"></i>
                                <a asp-controller="Home"
                                   asp-action="Update"
                                   asp-route-id="@Model._id"
                                   class="text-white text-center">
                                    Edit
                                </a>
                            </div>
                        </div>
                        
                    </div>

                    <p class="mt-3 mb-0">@Model.about</p>

                    <hr class="my-3" />

                    <div class="row gy-2">
                        <div class="col-12 col-sm-6"><strong>Email:</strong> @Model.email</div>
                        <div class="col-12 col-sm-6"><strong>Phone:</strong> @Model.phone</div>
                        <div class="col-12 col-sm-6"><strong>Age:</strong> @Model.age</div>
                        <div class="col-12 col-sm-6"><strong>Gender:</strong> @Model.gender</div>
                        <div class="col-12 col-sm-6"><strong>Eye color:</strong> @Model.eyeColor</div>
                        <div class="col-12">
                            <strong>Registered:</strong> @((Model.registered ?? "").Replace('T', ' '))
                        </div>
                    </div>

                    <hr class="my-3" />

                    <div class="mb-1"><strong>Address:</strong></div>
                    <div >
                        @(Model.address?.number), @(Model.address?.street)<br />
                        @(Model.address?.city), @(Model.address?.state)
                    </div>
                    <div class="mb-3">
                        Zip Code: @(Model.address?.zipcode)
                    </div>
   

                    <div class="mb-3">
                        <strong>Location:</strong> @Model.latitude, @Model.longitude
                    </div>

                    <hr class="my-3" />

                    <div class="mb-2"><strong>Tags</strong></div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var t in (Model.tags ?? new List<string>()))
                        {
                            <span class="badge bg-secondary">@t</span>
                        }
                    </div>
                    <hr class="my-3" />
                    <div class=" text-center my-2 mx-4">
                        <div class="d-block btn btn-dark btn-sm">
                            <i class="bi bi-signpost-split"></i>
                            <a asp-controller="Home"
                               asp-action="Distance"
                               asp-route-id="@Model._id"
                               class="text-white text-center">
                                Distance from your location
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
