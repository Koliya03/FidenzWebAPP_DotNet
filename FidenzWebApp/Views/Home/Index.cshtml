@model List<FidenzApp.Application.DTO.CustomerDto>
@using System.Linq

<div class="d-flex justify-content-end align-items-center gap-2 mt-2 bg-white  box-shadow mb-3 py-3">
    <a asp-controller="Home" asp-action="Logout"
       class="btn btn-outline-danger">
        <i class="bi bi-box-arrow-right"></i> Logout
    </a>
</div>


<div class="d-flex justify-content-between align-items-start mt-2">
    <form class="d-flex align-items-center" asp-controller="Home" asp-action="Index" method="get">
        <input name="Search" class=" form-control "
               type="search" placeholder="Seach by name" />
        <button class="btn btn-dark" type="submit">Search</button>
        <a asp-action="Index" class="mx-2  bi bi-arrow-clockwise btn border"></a>
    </form>


    <a asp-controller="Home" asp-action="GroupByZip"
       class="btn btn-outline-success">View all group By Zip Code</a>

</div>

<div class="w-100 card border-0 m-4">
    <div class="class-header bg-black bg-gradient ml-0 py-3 rounded-3">
        <div class="row">
            <div class="text-center">
                <h2 class="text-white py-2">Customer List</h2>
            </div>
        </div>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <h1 class="alert mt-3 text-center">No results found.</h1>
}
else
{
    <div class="row">
        @foreach (var c in Model)
        {
            <div class="col col-sm-6 mb-3 mb-sm-0 pt-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-8">
                                <h5 class="card-title mb-1">@c.name</h5>
                                <div class="d-flex align-items-baseline">

                                    <i class="bi bi-building"></i>
                                    <p class="card-subtitle text-muted ">
                                        @c.company
                                    </p>
                                </div>

                            </div>
                            <div class="col-4 ">
                                <a asp-controller="Home"
                                   asp-action="Update"
                                   asp-route-id="@c._id"
                                   class="text-white text-center  d-block btn btn-primary btn-sm">
                                    <i class="bi bi-pencil-square"></i>
                                    Edit
                                </a>
                            </div>
                        </div>


                        <hr class="my-3" />

                        <ul class="list-unstyled small mb-4">
                            <li><strong>Email:</strong> @c.email</li>
                            <li><strong>Phone:</strong> @c.phone</li>
                            <li><strong>Age:</strong> @c.age</li>
                            <li><strong>Eye color:</strong> @c.eyeColor</li>
                        </ul>
                        <div class="d-flex p-3">
                            <div class="col-6 text-center">
                                <a asp-controller="Home"
                                   asp-action="Distance"
                                   asp-route-id="@c._id"
                                   class="text-white text-center  d-block btn btn-secondary btn-sm">
                                    <i class="bi bi-signpost-split"></i>
                                    Distance from your location
                                </a>
                            </div>

                            <div class="col-6 text-center">
                                <a asp-controller="Home"
                                   asp-action="ViewInfo"
                                   asp-route-id="@c._id"
                                   class="btn border-2 border-secondary btn-sm text-start">
                                    View all Info
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}

